{
  "name": "@marketing-blast/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsc && node --env-file=../../.env dist/migrate.js && node --env-file=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "dns:check": "node dist/scripts/check-dns.js",
    "migrate": "node dist/migrate.js",
    "test": "node --test \"dist/test/*.test.js\"",
    "check": "tsc && node --test \"dist/test/*.test.js\"",
    "dev:worker": "tsc && node --env-file=../../.env dist/worker.js",
    "migrate:local": "node --env-file=../../.env dist/migrate.js"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "fastify": "5.2.1",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "typescript": "5.6.3"
  }
}
