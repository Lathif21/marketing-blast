# Salin menjadi .env. Jangan pernah commit .env.
#
# Seluruh nilai di berkas ini adalah DUMMY dan aman dijalankan apa adanya:
# MAIL_DRIVER=dummy menahan semua email di dalam sistem, jadi tidak ada yang
# bisa terkirim ke alamat sungguhan sebelum Anda sengaja menggantinya.
#
# Cara mengganti dengan nilai asli:
#   docs/07-domain-dan-dns.md   — domain pengirim, SPF, DKIM, DMARC
#   docs/08-amazon-ses.md       — akun AWS, verifikasi domain, keluar sandbox

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=blast
POSTGRES_PASSWORD=ganti-password-ini
POSTGRES_DB=marketing_blast

# Port di host. Ganti bila port bawaan sudah dipakai proses lain.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=3000

# Dipakai saat API dijalankan LANGSUNG di host (npm run dev:api), bukan di
# dalam container. Docker Compose menyusun nilainya sendiri dan mengabaikan
# dua baris ini, jadi keduanya boleh berbeda tanpa saling mengganggu.
#
# Host-nya 127.0.0.1 dan portnya mengikuti POSTGRES_HOST_PORT di atas.
DATABASE_URL=postgres://blast:ganti-password-ini@127.0.0.1:5432/marketing_blast
APP_DATABASE_URL=postgres://blast_app:ganti-password-app-ini@127.0.0.1:5432/marketing_blast

# Antarmuka yang didengarkan saat API dijalankan LANGSUNG di host. Dikunci ke
# localhost supaya API pengembangan tidak ikut terbuka ke jaringan lokal.
# Docker Compose tidak meneruskan variabel ini, jadi di dalam container proses
# tetap mendengar di 0.0.0.0 sebagaimana mestinya.
HOST=127.0.0.1

# Peran aplikasi. Dibuat runner migrasi, dan sengaja BUKAN pemilik skema:
# peran ini tidak punya hak DELETE pada tabel suppression, sehingga aturan
# "daftar penekanan permanen" ditegakkan basis data, bukan hanya oleh kode.
#
# Kalau APP_DB_PASSWORD dikosongkan, aplikasi terpaksa memakai koneksi pemilik
# dan larangan itu TIDAK aktif -- diperingatkan saat start.
APP_DB_USER=blast_app
APP_DB_PASSWORD=ganti-password-app-ini

# ─── Rahasia aplikasi ─────────────────────────────────────────────────────────
# Kunci HMAC token berhenti berlangganan. WAJIB diisi, minimal 32 karakter.
# Token yang bisa ditebak memungkinkan orang lain menghentikan langganan
# kontak yang bukan miliknya.
#
#   openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# URL publik yang dilihat penerima email. Harus dapat diakses dari luar tanpa
# autentikasi -- di sinilah tautan berhenti berlangganan mendarat.
PUBLIC_BASE_URL=https://blast.contoh.id

# ─── Dekripsi berkas .enc ─────────────────────────────────────────────────────
# Harus sama persis dengan crypto_utils.py di Contact Harvester. Kalau impor
# gagal terus dengan pesan "kata sandi salah" padahal sandinya benar, dua angka
# inilah yang pertama dicurigai.
ENC_SALT_BYTES=16
ENC_PBKDF2_ITERATIONS=480000

# ─── Driver email ─────────────────────────────────────────────────────────────
# dummy — pesan dicatat dan ditulis sebagai .eml, tidak ada yang keluar
# ses   — benar-benar mengirim lewat Amazon SES
#
# Biarkan `dummy` sampai seluruh prasyarat di docs/08-amazon-ses.md terpenuhi.
# Menyetel `ses` sebelum itu akan membuat proses gagal start, bukan diam-diam
# tidak mengirim.
MAIL_DRIVER=dummy
MAIL_OUTBOX_DIR=/app/var/outbox

# ─── Domain pengirim (DUMMY) ──────────────────────────────────────────────────
# Subdomain khusus kampanye. TIDAK boleh sama dengan domain korespondensi
# harian perusahaan — kalau reputasi pengirim jatuh, email operasional ikut
# terbawa (01-arsitektur.md).
#
# SPF, DKIM, dan DMARC wajib terkonfigurasi sebelum pengiriman pertama.
# Periksa dengan: docker compose exec api npm run dns:check
SENDER_DOMAIN=blast.contoh.id
SENDER_MAIL_FROM_SUBDOMAIN=mail
SENDER_ADDRESS=blast@blast.contoh.id
SENDER_NAME=Nusantara Sales
SENDER_POSTAL_ADDRESS=Jl. Sudirman No. 45, Jakarta Selatan 12190

# ─── DMARC (DUMMY) ────────────────────────────────────────────────────────────
# Mulai dari p=none supaya laporan masuk tanpa ada email yang ditolak. Naikkan
# ke quarantine lalu reject setelah laporan bersih — docs/07-domain-dan-dns.md.
DMARC_REPORT_TO=dmarc@contoh.id
DMARC_POLICY=none

# ─── Amazon SES (DUMMY) ───────────────────────────────────────────────────────
# Belum dipakai sampai Fase 2, tapi permintaan keluar dari sandbox diajukan di
# Fase 0 karena prosesnya memakan waktu dan menghambat semua pengujian kirim.
#
# Kunci di bawah sengaja dikosongkan. Jangan pernah isi dengan kunci root AWS —
# buat IAM user khusus dengan izin minimal (docs/08-amazon-ses.md).
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=marketing-blast-events

# Tiga token DKIM dari konsol SES, dipisah koma. Selama kosong, pemeriksa DNS
# memakai token contoh yang memang tidak akan pernah cocok.
SES_DKIM_TOKENS=

# ─── Integrasi Gmail ──────────────────────────────────────────────────────────
# Menyambungkan kotak masuk tim untuk dua hal: mencatat balasan kampanye
# otomatis, dan mengimpor alamat yang pernah berkorespondensi DUA ARAH.
#
# Kosongkan GOOGLE_CLIENT_ID untuk mematikan integrasi sepenuhnya — rutenya
# membalas 503 dan tombolnya tidak muncul. Setengah terisi ditolak saat start,
# bukan gagal saat pengguna sudah setengah jalan di halaman izin Google.
#
# Langkah pembuatan kredensial ada di docs/11-integrasi-gmail.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Harus sama PERSIS dengan yang terdaftar di Google Cloud Console — termasuk
# skema, port, dan garis miring akhir. Ketidakcocokan sekecil apa pun dijawab
# Google dengan `redirect_uri_mismatch`, dan pesan itu tidak menyebutkan bagian
# mana yang berbeda.
GOOGLE_REDIRECT_URI=http://localhost:3000/integrasi/gmail/callback

# Kunci enkripsi token penyegar Gmail (AES-256-GCM). Minimal 32 karakter.
# Buat dengan: openssl rand -hex 32
#
# Terpisah dari UNSUBSCRIBE_SECRET dengan sengaja: token berhenti berlangganan
# yang bocor menghentikan langganan orang, token penyegar Gmail yang bocor
# membuka kotak masuk seseorang. Memakai satu kunci untuk keduanya berarti
# memutar salah satunya memaksa memutar keduanya.
#
# MEMUTAR KUNCI INI membuat seluruh koneksi yang ada tidak dapat dibaca lagi,
# dan setiap pengguna harus menyambungkan ulang kotak masuknya.
TOKEN_SECRET=
